      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ourServices": {
      "type": "component",
      "component": "home.service",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "contactInfo": {
      "type": "component",
      "component": "home.contact-info",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
